# ---------------------------------------------------------------------------
# StudioOS environment configuration (development defaults)
# Copy to .env and replace every placeholder. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5174
API_BASE_URL=http://localhost:4000/api/v1
# Set to true only behind a trusted reverse proxy (affects rate-limit IPs).
TRUST_PROXY=false

DATABASE_URL=postgresql://studioos:studioos@localhost:5432/studio_os
TEST_DATABASE_URL=postgresql://studioos:studioos@localhost:5432/studio_os_test
REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=studioos_session
CSRF_COOKIE_NAME=studioos_csrf
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=168

# Frontend
VITE_API_URL=http://localhost:4000/api/v1

# Object storage (Milestone 4)
S3_REGION=us-east-1
S3_BUCKET=studioos-development
S3_ACCESS_KEY_ID=s3mock
S3_SECRET_ACCESS_KEY=s3mock
S3_ENDPOINT=http://localhost:9090
S3_AUTO_CREATE_BUCKET=true
UPLOAD_URL_TTL_MINUTES=15
DOWNLOAD_URL_TTL_MINUTES=10
ASSET_MAX_BYTES=262144000

# Email delivery (Milestone 5)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=StudioOS <no-reply@example.com>
QUEUE_PREFIX=studioos
EMAIL_JOB_ATTEMPTS=4
EMAIL_JOB_BACKOFF_MS=5000
MONITORING_WEBHOOK_URL=

INVITATION_BASE_URL=http://localhost:5174/invitations
PASSWORD_RESET_BASE_URL=http://localhost:5174/password/reset

LOG_LEVEL=debug

# Seed only (development). Never set this in production.
SEED_DEMO_PASSWORD=replace-with-a-development-only-password

# Runtime API docs are disabled unless explicitly enabled.
API_DOCS_ENABLED=true

# Return invite/reset links in API responses and UI. Local development only.
DEV_LINKS_ENABLED=true
