# Copy to .env.production and fill every placeholder. Never commit real values.
#
# Vercel: the values are synced to the project with `npm run vercel:env`.
# Compose: `docker compose -f docker-compose.prod.yml --env-file .env.production ...`
#
# Vercel does not run the postgres/redis containers; use managed services and
# the POSTGRES_* values stay compose-only.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://app.example.com
API_BASE_URL=https://app.example.com/api/v1
TRUST_PROXY=true
VITE_API_URL=/api/v1

# Managed PostgreSQL. Use the provider's pooled URL for the application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/studio_os?sslmode=require
# Optional direct (non-pooled) URL for migrations. Leave empty to use
# DATABASE_URL. Set it when the provider uses PgBouncer and migrations need a
# direct connection.
DIRECT_DATABASE_URL=

# Managed Redis for BullMQ. Prefer rediss:// for TLS.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

SESSION_SECRET=replace-with-64-hex-characters
SESSION_COOKIE_NAME=studioos_session
CSRF_COOKIE_NAME=studioos_csrf
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=168
INVITATION_BASE_URL=https://app.example.com/invitations
PASSWORD_RESET_BASE_URL=https://app.example.com/password/reset

# Private S3-compatible bucket. Leave S3_ENDPOINT empty for AWS S3; set it for
# R2, MinIO, Wasabi, Backblaze, etc. The browser needs CORS access to the
# endpoint, and the credentials need s3:ListBucket plus object access.
S3_REGION=us-east-1
S3_BUCKET=studioos-production
S3_ACCESS_KEY_ID=replace-with-production-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-secret
S3_ENDPOINT=
S3_AUTO_CREATE_BUCKET=false
UPLOAD_URL_TTL_MINUTES=15
DOWNLOAD_URL_TTL_MINUTES=10
ASSET_MAX_BYTES=262144000

EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-resend-api-key
# Production: a sender on a domain verified in Resend.
# No-domain smoke test only: StudioOS <onboarding@resend.dev> (delivers only
# to the Resend account owner's email address).
EMAIL_FROM=StudioOS <no-reply@example.com>
QUEUE_PREFIX=studioos
EMAIL_JOB_ATTEMPTS=4
EMAIL_JOB_BACKOFF_MS=5000

MONITORING_WEBHOOK_URL=
LOG_LEVEL=info

# Keep disabled unless docs are intentionally exposed.
API_DOCS_ENABLED=false

# Never expose invite/reset links in production responses.
DEV_LINKS_ENABLED=false

# Never set seed credentials in production.
SEED_PASSWORD=

# --- Self-hosted Docker Compose only -------------------------------------
# These are ignored by Vercel and are not synced by `npm run vercel:env`.
POSTGRES_USER=studioos
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=studio_os
REDIS_PASSWORD=replace-with-a-strong-redis-password
API_IMAGE=ghcr.io/your-org/studioos/api:latest
WEB_IMAGE=ghcr.io/your-org/studioos/web:latest
WEB_PORT=8080
