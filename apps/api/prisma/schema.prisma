// StudioOS schema — Milestone 3
// Shared-schema multi-tenancy: tenant-owned models carry organizationId and
// related records share composite foreign keys where practical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  DEACTIVATED
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum EmailOtpPurpose {
  REGISTRATION
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum OrgRole {
  ADMIN
  PROJECT_MANAGER
  PRODUCER
  EDITOR
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ClientMembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum InvitationType {
  INTERNAL
  CLIENT
}

enum ContentType {
  VIDEO
  PODCAST
  SOCIAL_POST
  ARTICLE
  DESIGN
  OTHER
}

enum ContentStatus {
  BRIEF
  SCRIPT
  SHOOT
  EDITING
  INTERNAL_REVIEW
  CLIENT_APPROVAL
  READY_TO_PUBLISH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewDecision {
  INTERNAL_FEEDBACK
  CLIENT_APPROVED
  CLIENT_REVISION_REQUESTED
}

enum NotificationType {
  TASK_ASSIGNED
  CONTENT_ASSIGNED
  CONTENT_SUBMITTED
  REVIEW_FEEDBACK
  CONTENT_APPROVED
  REVISION_REQUESTED
  DEADLINE_REMINDER
  INVITATION
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  PROCESSED
  FAILED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(120)
  email           String     @unique @db.VarChar(320)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          OrganizationMembership[]
  clientMemberships    ClientMembership[]
  projectMemberships   ProjectMembership[]
  contentItemsAssigned ContentItem[]            @relation("ContentAssignee")
  tasksAssigned        Task[]                   @relation("TaskAssignee")
  tasksCreated         Task[]                   @relation("TaskCreator")
  workflowEvents       WorkflowEvent[]          @relation("WorkflowActor")
  assetsUploaded       Asset[]
  uploadsCreated       AssetUpload[]
  reviewsAuthored      Review[]
  notifications        Notification[]
  sessions             Session[]
  invitationsSent      Invitation[]             @relation("InvitationInvitedBy")
  passwordResetTokens  PasswordResetToken[]
  emailOtpCodes        EmailOtpCode[]
  oauthAccounts        OAuthAccount[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(160)
  slug      String             @unique @db.VarChar(80)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        OrganizationMembership[]
  clients            Client[]
  clientMemberships  ClientMembership[]
  projects           Project[]
  projectMemberships ProjectMembership[]
  contentItems       ContentItem[]
  tasks              Task[]
  workflowEvents     WorkflowEvent[]
  assets             Asset[]
  assetUploads       AssetUpload[]
  reviews            Review[]
  notifications      Notification[]
  outboxEvents       OutboxEvent[]
  invitations        Invitation[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrgRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model Client {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String       @db.VarChar(160)
  contactName     String?      @map("contact_name") @db.VarChar(120)
  email           String?      @db.VarChar(320)
  phone           String?      @db.VarChar(40)
  website         String?      @db.VarChar(255)
  notes           String?      @db.Text
  brandGuidelines String?      @map("brand_guidelines") @db.Text
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  ClientMembership[]
  projects     Project[]
  invitations  Invitation[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@map("clients")
}

model ClientMembership {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  clientId       String                 @map("client_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  status         ClientMembershipStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([organizationId, userId, status])
  @@index([clientId, status])
  @@map("client_memberships")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  name           String        @db.VarChar(160)
  description    String?       @db.Text
  status         ProjectStatus @default(ACTIVE)
  startDate      DateTime?     @map("start_date") @db.Date
  deadline       DateTime?     @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  memberships  ProjectMembership[]
  contentItems ContentItem[]
  tasks        Task[]
  assets       Asset[]
  assetUploads AssetUpload[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deadline])
  @@index([organizationId, clientId])
  @@map("projects")
}

model ProjectMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId, userId])
  @@index([projectId])
  @@map("project_memberships")
}

model ContentItem {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  title          String        @db.VarChar(200)
  description    String?       @db.Text
  type           ContentType
  status         ContentStatus @default(BRIEF)
  deadline       DateTime?     @db.Date
  assigneeId     String?       @map("assignee_id") @db.Uuid
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee       User?           @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  tasks          Task[]
  workflowEvents WorkflowEvent[]
  assets         Asset[]
  assetUploads   AssetUpload[]
  reviews        Review[]

  @@unique([id, organizationId])
  @@unique([id, projectId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, deadline])
  @@map("content_items")
}

model WorkflowEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  contentItemId  String        @map("content_item_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  fromStatus     ContentStatus @map("from_status")
  toStatus       ContentStatus @map("to_status")
  note           String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor        User?        @relation("WorkflowActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, contentItemId, createdAt])
  @@index([organizationId, createdAt])
  @@map("workflow_events")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  contentItemId  String?      @map("content_item_id") @db.Uuid
  title          String       @db.VarChar(200)
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @map("assignee_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contentItem  ContentItem? @relation(fields: [contentItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, dueDate])
  @@index([organizationId, assigneeId])
  @@index([organizationId, projectId])
  @@index([contentItemId])
  @@map("tasks")
}

model Asset {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  contentItemId    String?  @map("content_item_id") @db.Uuid
  uploadedById     String?  @map("uploaded_by_id") @db.Uuid
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  sizeBytes        Int      @map("size_bytes")
  storageKey       String   @unique @map("storage_key") @db.VarChar(512)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contentItem  ContentItem? @relation(fields: [contentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  reviews      Review[]

  @@unique([id, organizationId])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, contentItemId, createdAt])
  @@map("assets")
}

model AssetUpload {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  contentItemId    String?   @map("content_item_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  originalFilename String    @map("original_filename") @db.VarChar(255)
  mimeType         String    @map("mime_type") @db.VarChar(120)
  sizeBytes        Int       @map("size_bytes")
  storageKey       String    @unique @map("storage_key") @db.VarChar(512)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  contentItem  ContentItem? @relation(fields: [contentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, expiresAt])
  @@index([organizationId, completedAt])
  @@map("asset_uploads")
}

model Review {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  contentItemId  String         @map("content_item_id") @db.Uuid
  reviewerId     String?        @map("reviewer_id") @db.Uuid
  assetId        String?        @map("asset_id") @db.Uuid
  decision       ReviewDecision
  contentVersion Int            @map("content_version")
  feedback       String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviewer     User?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, contentItemId, createdAt])
  @@index([organizationId, decision, createdAt])
  @@map("reviews")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  body           String?          @db.Text
  payload        Json?
  dedupeKey      String?          @unique @map("dedupe_key") @db.VarChar(160)
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model OutboxEvent {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String?      @map("organization_id") @db.Uuid
  type              String       @db.VarChar(80)
  payloadCiphertext String       @map("payload_ciphertext") @db.Text
  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  availableAt       DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt      DateTime?    @map("dispatched_at") @db.Timestamptz(3)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError         String?      @map("last_error") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  type           InvitationType @default(INTERNAL)
  email          String         @db.VarChar(320)
  role           OrgRole?
  tokenHash      String         @unique @map("token_hash") @db.VarChar(64)
  invitedById    String         @map("invited_by_id") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, acceptedAt])
  @@index([organizationId, type])
  @@index([clientId])
  @@index([expiresAt])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailOtpCode {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  purpose    EmailOtpPurpose @default(REGISTRATION)
  codeHash   String          @map("code_hash") @db.VarChar(64)
  attempts   Int             @default(0)
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_otp_codes")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  email             String?       @db.VarChar(320)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
